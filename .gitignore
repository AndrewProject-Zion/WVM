/target
**/target
*.qcow2
*.img
*.iso
# Never commit guest credentials or install keys.
*.key
*.pem
vm_password.txt

# The guest binary is built, not tracked. It is served to the guest over HTTP for install;
# committing a 500 KB executable that goes stale on every build is how a repo fills up.
/scripts/wvm-guest.exe

# Python bytecode. Generated, not source.
__pycache__/
*.pyc

# Editor and agent backup files. These are working artefacts, not source — a timestamped copy of a
# file that is also in the tree is noise in a public repository, and one was committed by accident.
*.bak
*.bak.*
*.orig
